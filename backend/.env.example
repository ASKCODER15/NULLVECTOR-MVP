# NullVector backend configuration.
# Copy this file to .env and adjust. Every value below is a safe local default,
# so the backend starts even if a field is omitted.

PROJECT_NAME=NullVector
PROJECT_VERSION=0.2.0

DEBUG=false
HOST=127.0.0.1
PORT=8000

# LM Studio must be running with its OpenAI-compatible server enabled.
# The URL must include the API prefix; services append /chat/completions.
LM_STUDIO_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=qwen/qwen3-8b

# Per-request budget for one target call during a scan, in seconds.
SCAN_TIMEOUT_SECONDS=15

LOG_LEVEL=INFO

# Comma-separated origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000,http://127.0.0.1:3000
